#!/usr/bin/env sh
#
# Runs from the git repo root (…/HackInMotion-RICR-HIM-1016). Change into
# the Next.js project directory so lint-staged, npx, and eslint all find
# their configs, then run with --relative so file paths passed to eslint
# are relative to the project (not the git root).

cd "$(dirname "$0")/.." || exit 1

# Only run lint-staged if any of the staged files live in this project.
if git diff --cached --name-only --diff-filter=ACM | grep -q '^smart-expense/'; then
  npx --no-install lint-staged --relative
fi
