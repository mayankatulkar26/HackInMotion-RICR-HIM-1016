# --- Database (MongoDB) ---
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/smart-expense
# Kept for backwards compat with older code paths; safe to remove.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-expense

# --- Auth ---
AUTH_SECRET=your-32-char-random-secret
AUTH_URL=http://localhost:3000
# Legacy NextAuth v4 names (kept so redeploys of older revs still work):
NEXTAUTH_SECRET=your-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Email / SMTP (used for OTP signup + password reset) ---
# The code reads exactly these variable names — do NOT rename to
# SMTP_PASSWORD, EMAIL_USER, EMAIL_PASSWORD, etc. See src/lib/email.ts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password    # NOT your Gmail login password — see below

# Gmail requires an "App Password" (16 chars, no spaces) for SMTP:
#   1. Enable 2FA on the Google account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate an app password for "Mail" — paste it into SMTP_PASS

# --- AI Providers (set at least one; both is fine) ---
# Gemini is preferred; Groq is the automatic fallback if Gemini errors / hits quota.
#   Gemini → https://aistudio.google.com/apikey
#   Groq   → https://console.groq.com/keys
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest         # optional override

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile       # optional override
