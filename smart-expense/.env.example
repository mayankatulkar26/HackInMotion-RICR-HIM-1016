# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-expense
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/smart-expense

# Email Configuration (Gmail SMTP)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Alternative: Custom SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret-key-here
AUTH_URL=http://localhost:3000

# --- AI Providers (set at least one; both is fine) ---
# Gemini is preferred; Groq is the automatic fallback if Gemini errors / hits quota.
# Get free keys:
#   Gemini → https://aistudio.google.com/apikey
#   Groq   → https://console.groq.com/keys
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest         # optional override

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile       # optional override
