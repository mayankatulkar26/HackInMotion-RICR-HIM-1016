# --- Database (MongoDB) ---
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/smart-expense
# Kept for backwards compat with older code paths; safe to remove.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-expense

# --- Auth ---
AUTH_SECRET=your-32-char-random-secret
AUTH_URL=http://localhost:3000
# Legacy NextAuth v4 names (kept so redeploys of older revs still work):
NEXTAUTH_SECRET=your-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Email (used for OTP signup + password reset) ---
#
# Two providers supported — set at least one. If both are set Resend is tried
# first, SMTP is the fallback.
#
# 1) Resend (RECOMMENDED — works on any host including Render/Vercel free)
#    Get a free key at https://resend.com/api-keys (3,000 emails/month free).
#    No domain setup needed — `onboarding@resend.dev` is a working sandbox
#    sender. For prod, verify your domain and set RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=Wealth Sight <onboarding@resend.dev>

# 2) SMTP (fallback — works locally, often blocked on serverless free tiers)
#    Gmail: need an App Password (16 chars). Enable 2FA first, then
#    generate at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=optional-custom-from-address@example.com

# --- AI Providers (set at least one; both is fine) ---
# Gemini is preferred; Groq is the automatic fallback if Gemini errors / hits quota.
#   Gemini → https://aistudio.google.com/apikey
#   Groq   → https://console.groq.com/keys
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest         # optional override

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile       # optional override
