# --- Auth ---
# Generate with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"

# --- Database (MongoDB) ---
# Local: mongodb://localhost:27017/smart_expense
# Atlas: mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/smart_expense
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/smart_expense?retryWrites=true&w=majority"

# --- Google Gemini API ---
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
